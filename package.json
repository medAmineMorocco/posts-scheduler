{
  "name": "posts-scheduler",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "schedule": "tsx src/schedule.ts",
    "generate": "tsx src/generate-posts.ts",
    "schedule:local": "tsx --env-file=.env.local src/schedule.ts",
    "generate:local": "tsx --env-file=.env.local src/generate-posts.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@notionhq/client": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "dotenv": "^17.4.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
